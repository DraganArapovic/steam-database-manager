<!-- views/games/show.ejs -->
<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-controller"></i> Game Details</h2>
        <div>
            <a href="/games/<%= game._id %>/edit" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a href="/games" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-6">
            <h5>Game Information</h5>
            <table class="table">
                <tr>
                    <td><strong>Title:</strong></td>
                    <td><%= game.title %></td>
                </tr>
                <tr>
                    <td><strong>Description:</strong></td>
                    <td><%= game.description %></td>
                </tr>
                <tr>
                    <td><strong>Price:</strong></td>
                    <td>$<%= typeof game.base_price === 'object' ? parseFloat(game.base_price.$numberDecimal).toFixed(2) : parseFloat(game.base_price).toFixed(2) %></td>
                </tr>
                <tr>
                    <td><strong>Age Rating:</strong></td>
                    <td><%= game.age_rating %>+</td>
                </tr>
                <tr>
                    <td><strong>Status:</strong></td>
                    <td>
                        <% if (game.is_early_access) { %>
                            <span class="badge bg-warning">Early Access</span>
                        <% } else { %>
                            <span class="badge bg-success">Released</span>
                        <% } %>
                    </td>
                </tr>
            </table>
        </div>
        <div class="col-md-6">
            <h5>Developer & Publisher</h5>
            <table class="table">
                <tr>
                    <td><strong>Developer:</strong></td>
                    <td><%= game.developer ? game.developer.name : 'N/A' %></td>
                </tr>
                <tr>
                    <td><strong>Developer Country:</strong></td>
                    <td><%= game.developer ? game.developer.country_code : 'N/A' %></td>
                </tr>
                <tr>
                    <td><strong>Publisher:</strong></td>
                    <td><%= game.publisher ? game.publisher.name : 'N/A' %></td>
                </tr>
                <tr>
                    <td><strong>Platforms:</strong></td>
                    <td>
                        <% if (game.platforms) { %>
                            <% game.platforms.forEach(platform => { %>
                                <span class="badge bg-info"><%= platform %></span>
                            <% }); %>
                        <% } %>
                    </td>
                </tr>
                <tr>
                    <td><strong>Genres:</strong></td>
                    <td>
                        <% if (game.genres) { %>
                            <% game.genres.forEach(genre => { %>
                                <span class="badge bg-primary"><%= genre %></span>
                            <% }); %>
                        <% } %>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>