<!-- views/games/list.ejs -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-controller"></i> Games</h2>
    <a href="/games/new" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Game
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Title</th>
                <th>Developer</th>
                <th>Price</th>
                <th>Age Rating</th>
                <th>Platforms</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% games.forEach(game => { %>
                <tr>
                    <td><strong><%= game.title %></strong></td>
                    <td><%= game.developer ? game.developer.name : 'N/A' %></td>
                    <td>$<%= typeof game.base_price === 'object' ? parseFloat(game.base_price.$numberDecimal).toFixed(2) : parseFloat(game.base_price).toFixed(2) %></td>
                    <td><%= game.age_rating %>+</td>
                    <td>
                        <% if (game.platforms) { %>
                            <% game.platforms.forEach(platform => { %>
                                <span class="badge bg-info"><%= platform %></span>
                            <% }); %>
                        <% } %>
                    </td>
                    <td>
                        <% if (game.is_early_access) { %>
                            <span class="badge bg-warning">Early Access</span>
                        <% } else { %>
                            <span class="badge bg-success">Released</span>
                        <% } %>
                    </td>
                    <td class="action-buttons">
                        <a href="/games/<%= game._id %>" class="btn btn-sm btn-info">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a href="/games/<%= game._id %>/edit" class="btn btn-sm btn-warning">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form action="/games/<%= game._id %>?_method=DELETE" method="POST" style="display: inline;">
                            <button type="submit" class="btn btn-sm btn-danger delete-btn">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>