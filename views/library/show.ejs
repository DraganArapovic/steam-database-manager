<!-- views/library/show.ejs -->
<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-collection"></i> Library Entry Details</h2>
        <div>
            <a href="/library/<%= entry._id %>/edit" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a href="/library" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-6">
            <h5>Entry Information</h5>
            <table class="table">
                <tr>
                    <td><strong>Game:</strong></td>
                    <td><%= entry.game_snapshot ? entry.game_snapshot.title : 'Unknown Game' %></td>
                </tr>
                <tr>
                    <td><strong>User:</strong></td>
                    <td><%= entry.user ? entry.user.username : 'Unknown User' %></td>
                </tr>
                <tr>
                    <td><strong>Playtime:</strong></td>
                    <td><%= entry.playtime_minutes %> minutes</td>
                </tr>
                <tr>
                    <td><strong>Visibility:</strong></td>
                    <td>
                        <% if (entry.is_hidden) { %>
                            <span class="badge bg-secondary">Hidden</span>
                        <% } else { %>
                            <span class="badge bg-success">Visible</span>
                        <% } %>
                    </td>
                </tr>
            </table>
        </div>
        <div class="col-md-6">
            <h5>Dates</h5>
            <table class="table">
                <tr>
                    <td><strong>Acquired:</strong></td>
                    <td><%= entry.acquired_at ? new Date(entry.acquired_at).toLocaleString() : 'N/A' %></td>
                </tr>
                <tr>
                    <td><strong>Last Played:</strong></td>
                    <td><%= entry.last_played_at ? new Date(entry.last_played_at).toLocaleString() : 'Never' %></td>
                </tr>
                <tr>
                    <td><strong>Price at Acquisition:</strong></td>
                    <td>$<%= entry.game_snapshot && entry.game_snapshot.base_price ? (typeof entry.game_snapshot.base_price === 'object' ? parseFloat(entry.game_snapshot.base_price.$numberDecimal).toFixed(2) : parseFloat(entry.game_snapshot.base_price).toFixed(2)) : '0.00' %></td>
                </tr>
            </table>
        </div>
    </div>
</div>