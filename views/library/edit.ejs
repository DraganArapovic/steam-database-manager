<!-- views/library/edit.ejs -->
<div class="form-container">
    <h2 class="mb-4"><i class="bi bi-pencil-square"></i> Edit Library Entry</h2>
    <form action="/library/<%= entry._id %>?_method=PUT" method="POST">
        <div class="mb-3">
            <label class="form-label">Game</label>
            <input type="text" class="form-control" value="<%= entry.game_snapshot ? entry.game_snapshot.title : 'Unknown Game' %>" disabled>
        </div>
        <div class="mb-3">
            <label for="playtime_minutes" class="form-label">Playtime (minutes)</label>
            <input type="number" class="form-control" id="playtime_minutes" name="playtime_minutes" value="<%= entry.playtime_minutes %>">
        </div>
        <div class="mb-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="is_hidden" name="is_hidden" <%= entry.is_hidden ? 'checked' : '' %>>
                <label class="form-check-label" for="is_hidden">Hide in Library</label>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Update Entry</button>
        <a href="/library" class="btn btn-secondary">Cancel</a>
    </form>
</div>