<!-- views/library/list.ejs -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-collection"></i> Library Entries</h2>
    <a href="/library/new" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Entry
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Game</th>
                <th>User</th>
                <th>Playtime (min)</th>
                <th>Acquired</th>
                <th>Last Played</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% entries.forEach(entry => { %>
                <tr>
                    <td><strong><%= entry.game_snapshot ? entry.game_snapshot.title : 'Unknown Game' %></strong></td>
                    <td><%= entry.user ? entry.user.username : 'Unknown User' %></td>
                    <td><%= entry.playtime_minutes %></td>
                    <td><%= entry.acquired_at ? new Date(entry.acquired_at).toLocaleDateString() : 'N/A' %></td>
                    <td><%= entry.last_played_at ? new Date(entry.last_played_at).toLocaleDateString() : 'Never' %></td>
                    <td>
                        <% if (entry.is_hidden) { %>
                            <span class="badge bg-secondary">Hidden</span>
                        <% } else { %>
                            <span class="badge bg-success">Visible</span>
                        <% } %>
                    </td>
                    <td class="action-buttons">
                        <a href="/library/<%= entry._id %>" class="btn btn-sm btn-info">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a href="/library/<%= entry._id %>/edit" class="btn btn-sm btn-warning">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form action="/library/<%= entry._id %>?_method=DELETE" method="POST" style="display: inline;">
                            <button type="submit" class="btn btn-sm btn-danger delete-btn">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>